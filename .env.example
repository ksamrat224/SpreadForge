# Public devnet Result Registry deployment address. Leave unset until deployment.
NEXT_PUBLIC_RESULT_REGISTRY_PROGRAM_ID=

# MagicBlock is opt-in until the session-enabled registry is deployed to devnet.
NEXT_PUBLIC_MAGICBLOCK_ENABLED=false
NEXT_PUBLIC_MAGICBLOCK_BASE_RPC_URL=https://rpc.magicblock.app/devnet
NEXT_PUBLIC_MAGICBLOCK_ROUTER_URL=https://devnet-router.magicblock.app/
# Provisioned TEE endpoint. It must match the endpoint returned by the router
# for a delegated paper portfolio; leave empty until MagicBlock enables PER.
NEXT_PUBLIC_MAGICBLOCK_PRIVATE_ER_URL=
# MagicBlock-provisioned TEE validator public key. This is required to keep
# portfolio delegation from falling back to a public ER.
NEXT_PUBLIC_MAGICBLOCK_PRIVATE_ER_VALIDATOR=
# Enables the browser-to-server authentication flow. This is safe to expose;
# all endpoint details and bearer credentials below stay server-only.
NEXT_PUBLIC_MAGICBLOCK_PRIVATE_ER_AUTH_ENABLED=false

# Server-only Private ER authentication configuration. Do not use NEXT_PUBLIC_
# for these variables. These are MagicBlock's documented private-payment
# challenge/login endpoints; verify that the issued token is provisioned for
# your custom Private ER RPC before enabling ranked trading.
MAGICBLOCK_PRIVATE_ER_URL=
MAGICBLOCK_PRIVATE_ER_AUTH_CHALLENGE_URL=https://payments.magicblock.app/v1/spl/challenge
MAGICBLOCK_PRIVATE_ER_AUTH_LOGIN_URL=https://payments.magicblock.app/v1/spl/login
# Defaults to the origin of MAGICBLOCK_PRIVATE_ER_AUTH_LOGIN_URL plus
# /v1/transaction/send. This endpoint receives the Payments bearer for signed
# Private ER transaction relay; it is not the raw TEE JSON-RPC URL.
MAGICBLOCK_PRIVATE_ER_TRANSACTION_RELAY_URL=
# Generic TEE JSON-RPC is separate from the Payments API. `none` forwards no
# Payments bearer token (the safe default for the public devnet TEE). Switch
# to `payment-bearer` only if MagicBlock explicitly confirms that its token is
# accepted by the provisioned generic RPC endpoint.
MAGICBLOCK_PRIVATE_ER_GENERIC_RPC_AUTH=none
# Defaults to Authorization when omitted.
MAGICBLOCK_PRIVATE_ER_AUTH_HEADER=Authorization
# Defaults to "Bearer ". Set to an empty value only if MagicBlock provisions
# a raw token header (for example, an app-specific X-API-Key header).
MAGICBLOCK_PRIVATE_ER_AUTH_PREFIX="Bearer "

# Optional server-side Pyth Hermes API key for the SOL/USD route.
# Keep this server-only; do not use a NEXT_PUBLIC_ prefix.
PYTH_HERMES_URL=https://pyth.dourolabs.app/hermes
PYTH_HERMES_API_KEY=
