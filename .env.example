# Public devnet Result Registry deployment address. Leave unset until deployment.
NEXT_PUBLIC_RESULT_REGISTRY_PROGRAM_ID=

# MagicBlock is opt-in until the session-enabled registry is deployed to devnet.
NEXT_PUBLIC_MAGICBLOCK_ENABLED=false
NEXT_PUBLIC_MAGICBLOCK_BASE_RPC_URL=https://rpc.magicblock.app/devnet
NEXT_PUBLIC_MAGICBLOCK_ROUTER_URL=https://devnet-router.magicblock.app/

# Optional server-side Pyth Hermes API key for the SOL/USD route.
# Keep this server-only; do not use a NEXT_PUBLIC_ prefix.
PYTH_HERMES_URL=https://pyth.dourolabs.app/hermes
PYTH_HERMES_API_KEY=

# Server-only pusher configuration. This keypair pays the devnet fees required
# to maintain the deterministic Pyth price-feed accounts used by paper trades.
PAPER_PYTH_PUSHER_KEYPAIR=
PAPER_PYTH_RPC_URL=https://api.devnet.solana.com
PAPER_PYTH_HERMES_URL=https://pyth.dourolabs.app/hermes
# Optional comma-separated subset for a one-shot recovery update. Omit to push all markets.
PAPER_PYTH_FEED_IDS=
# Optional comma-separated market subset for a recovery registration. Omit to register all markets.
PAPER_MARKET_SYMBOLS=
PAPER_ADMIN_KEYPAIR=
